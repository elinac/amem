{
  "name": "@amem/amem-dsh-ui",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/host.js",
  "exports": {
    ".": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./client": "./dist/client.js"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": ["slots", "locale", "layout"]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "test": "node -e \"process.exit(0)\""
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "@types/react": "^19.0.10",
    "esbuild": "^0.25.0"
  }
}
