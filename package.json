{
  "name": "amem",
  "private": true,
  "version": "0.1.0",
  "description": "Cross-session agent memory with capability promotion",
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm run build && pnpm -r run test",
    "accept": "node scripts/accept.mjs",
    "accept:p0": "node scripts/accept-p0.mjs",
    "accept:p1": "node scripts/accept-p1.mjs",
    "accept:p2": "node scripts/accept-p2.mjs",
    "accept:dsh-admin": "node scripts/accept-dsh-admin.mjs",
    "accept:dsh-path": "node scripts/accept-dsh-path.mjs",
    "accept:dsh-session": "node scripts/accept-dsh-session.mjs",
    "smoke:dsh-session": "node scripts/smoke-dsh-session.mjs",
    "eval:recall": "node scripts/eval-recall.mjs",
    "eval:ab": "node scripts/eval-ab.mjs",
    "eval:ablate": "node scripts/eval-recall.mjs --ablate",
    "eval:signals": "node scripts/eval-signals.mjs",
    "lint": "biome check packages scripts docs/README.md GLOSSARY.md CHANGELOG.md biome.json",
    "lint:fix": "biome check --write packages scripts docs/README.md GLOSSARY.md CHANGELOG.md biome.json",
    "amem": "node packages/cli/dist/bin.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
